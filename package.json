{
    "name": "atmosphere-weather",
    "version": "1.0.70",
    "private": true,
    "type": "module",
    "description": "Atmosphere Weather for Windows 11",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
        "build": "tsc -b && vite build",
        "test": "node --test src/weather.test.mjs",
        "preview": "vite preview",
        "verify:animation": "node scripts/verify-animation.cjs",
        "verify:panels": "node scripts/verify-transparent-panels.cjs",
        "verify:persistence": "node scripts/verify-persistence.cjs",
        "verify:off-unchanged": "node scripts/verify-off-unchanged.cjs",
        "verify:packaged": "node scripts/verify-packaged.cjs",
        "verify:window-controls": "node scripts/verify-window-controls.cjs",
        "verify:maximize": "node scripts/verify-maximize-gesture.cjs",
        "verify:keyboard": "node scripts/verify-keyboard-routes.cjs",
        "verify:alt-f4": "node scripts/verify-alt-f4.cjs",
        "dist:win": "npm run build && electron-builder --config electron-builder.config.cjs --win nsis --x64",
        "dist:win:release": "node scripts/release-preflight.mjs && npm run build && cross-env ATMOSPHERE_RELEASE=1 electron-builder --config electron-builder.config.cjs --win nsis --x64"
    },
    "dependencies": {
        "electron-updater": "^6.8.9",
        "leaflet": "^1.9.4",
        "lucide-react": "^0.468.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-leaflet": "^4.2.1",
        "recharts": "^3.10.1"
    },
    "devDependencies": {
        "@types/leaflet": "^1.9.20",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "electron": "^44.0.0",
        "electron-builder": "^26.17.0",
        "playwright": "^1.64.1",
        "typescript": "~5.7.2",
        "vite": "^6.0.7",
        "wait-on": "^8.0.1"
    },
    "build": {
        "appId": "com.atmosphere.weather",
        "productName": "Atmosphere Weather",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "win": {
            "icon": "assets/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "overrides": {
        "rollup": "4.64.4"
    }
}
